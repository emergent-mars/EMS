// function that checks user against correct answer
void question(string answer[], int l_answer, bool n, string dn[], int l_dn, bool p, string dp[],int l_dp, bool m, string md[], int l_md, int max){
  
  // initialize vairables
  std:: string a;
  vector<int> c;
  int answer_correct;
  int max_doses;
  std::cout << "Dose is? ";
  std::getline(std::cin, a); // records user's answer as one string

  for (int i = 0; i < l_answer; i++){ c.push_back(a.find(answer[i]));} // checks if a contains each string of answer array, stores each in array of booleans
  
  for (int j = 0 ; j < l_answer; j++){
    answer_correct = c.at(j);
    if (answer_correct == std::string::npos) {break;}
  } // checks that boolean array is all true or stops and reports the false
  
  if(answer_correct != std::string::npos){ std::cout << "Correct!";} // only prints correct if entire array of booleans = true
  else { std::cout << "Incorrect :(\nAnswer was: ";
    for(int k = 0; k < l_answer; k++){cout << answer[k]  << " ";}
  } // print answer array

  c.clear();
  std::cout << "\n";

  // check dose2

  if(n){
     std::cout << "Other dose is? ";
     std::getline(std::cin, a); // records user's answer as one string

     for (int i = 0; i < l_dn; i++){ c.push_back(a.find(dn[i]));} // checks if a contains each string of answer array, stores each in array of booleans
     
     for (int j = 0 ; j < l_dn; j++){
       answer_correct = c.at(j);
       if (answer_correct == std::string::npos) {break;}
     } // checks that boolean array is all true or stops and reports the false
     
     if(answer_correct != std::string::npos){ std::cout << "Correct!";} // only prints correct if entire array of booleans = true
     else { std::cout << "Incorrect :(\nAnswer was: ";
       for(int k = 0; k < l_dn; k++){cout << dn[k]  << " ";}
     } // print answer array

     c.clear();
     std::cout << "\n";
  }
  
  // check peds
  if(p){
    std::cout << "Peds dose is? ";
    std::getline(std::cin, a); // records user's answer as one string
    
    for (int i = 0; i < l_dp; i++){ c.push_back(a.find(dp[i]));} // checks if a contains each string of answer array, stores each in array of booleans
    
    for (int j = 0 ; j < l_dp; j++){
      answer_correct = c.at(j);
      if (answer_correct == std::string::npos) {break;}
    } // checks that boolean array is all true or stops and reports the false
    
    if(answer_correct != std::string::npos){ std::cout << "Correct!";} // only prints correct if entire array of booleans = true
    else { std::cout << "Incorrect :(\nAnswer was: ";
      for(int k = 0; k < l_dp; k++){cout << dp[k]  << " ";}
    } // print answer array

    c.clear();
    std::cout << "\n";
  }

  // check max dose

  if(m){
    std::cout << "How many times may it be given? ";
    std::cin >> max_doses;
    
    if(max_doses == max){std::cout << "Correct!";} else{std::cout << "Incorrect :(" << "\nCorrect answer was " << max << ".";}

    std::cin.ignore();
    std::cout << "\n";

    std::cout << "And the max dose is? ";
    std::getline(std::cin, a); // records user's answer as one string
    
    for (int i = 0; i < l_md; i++){ c.push_back( a.find(md[i]));} // checks if a contains each string of answer array, stores each in array of booleans
    
    for (int j = 0 ; j < l_md; j++){
      answer_correct = c.at(j);
      if (answer_correct == std::string::npos) {break;}
    } // checks that boolean array is all true or stops and reports the false
    
    if(answer_correct != std::string::npos){ std::cout << "Correct!";} // only prints correct if entire array of booleans = true
    else { std::cout << "Incorrect :(\nAnswer was: ";
      for(int k = 0; k < l_md; k++){cout << md[k]  << " ";}
    } // print answer array

    c.clear();
    std::cout << "\n";
  }
  
} // end of question function


